<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DeskVerse dark graphite palette -->
    <Color x:Key="GraphiteBaseColor">#14161c</Color>
    <Color x:Key="GraphitePanelColor">#1b1e26</Color>
    <Color x:Key="GraphiteCardColor">#22262f</Color>
    <Color x:Key="GraphiteElevatedColor">#2a2f3a</Color>
    <Color x:Key="GraphiteBorderColor">#323846</Color>
    <Color x:Key="TextPrimaryColor">#e8ecf4</Color>
    <Color x:Key="TextSecondaryColor">#9aa3b5</Color>
    <Color x:Key="TextMutedColor">#6b7280</Color>
    <Color x:Key="AccentAmberColor">#f5a623</Color>
    <Color x:Key="AccentVioletColor">#6c5ce7</Color>
    <Color x:Key="AccentTealColor">#17b8a6</Color>
    <Color x:Key="DangerColor">#e0555f</Color>
    <Color x:Key="SuccessColor">#3fb96b</Color>

    <SolidColorBrush x:Key="GraphiteBaseBrush" Color="{StaticResource GraphiteBaseColor}" />
    <SolidColorBrush x:Key="GraphitePanelBrush" Color="{StaticResource GraphitePanelColor}" />
    <SolidColorBrush x:Key="GraphiteCardBrush" Color="{StaticResource GraphiteCardColor}" />
    <SolidColorBrush x:Key="GraphiteElevatedBrush" Color="{StaticResource GraphiteElevatedColor}" />
    <SolidColorBrush x:Key="GraphiteBorderBrush" Color="{StaticResource GraphiteBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentVioletColor}" />
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <!-- Typography -->
    <x:Double x:Key="DisplayTitleSize">28</x:Double>
    <x:Double x:Key="TitleSize">20</x:Double>
    <x:Double x:Key="SubtitleSize">15</x:Double>
    <x:Double x:Key="BodySize">13</x:Double>
    <x:Double x:Key="CaptionSize">11</x:Double>

    <Style x:Key="DisplayTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DisplayTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SubtitleSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- Panels and cards -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GraphitePanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GraphiteBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GraphiteCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GraphiteBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="PageHeaderPanel" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="MetricValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
        <Setter Property="Foreground" Value="#14161c" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GraphiteElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GraphiteBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <!-- Pills / chips -->
    <Style x:Key="InfoPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GraphiteElevatedBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <!-- Metric tile: border-based -->
    <Style x:Key="MetricTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GraphiteCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GraphiteBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

</ResourceDictionary>
