<Window
    x:Class="Deskverse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Deskverse.App.Views">

    <Grid x:Name="Root" Background="{StaticResource GraphiteBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="/Assets/icon256.png" Width="20" Height="20" />
                <TextBlock
                    Text="DeskVerse"
                    Style="{StaticResource SubtitleText}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="216"
            Background="{StaticResource GraphitePanelBrush}"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Discover" Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="My Wallpapers" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Collections" Tag="collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Studio" Tag="studio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Storage" Tag="storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" Background="{StaticResource GraphiteBaseBrush}" />
            </NavigationView.Content>
        </NavigationView>

        <!-- Bottom status bar -->
        <Border
            Grid.Row="2"
            Background="{StaticResource GraphitePanelBrush}"
            BorderBrush="{StaticResource GraphiteBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,6,14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{StaticResource AccentTealBrush}" />
                    <TextBlock
                        x:Name="StatusText"
                        Text="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                        Style="{StaticResource CaptionText}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <InfoBar
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    IsOpen="{x:Bind Vm.IsInfoOpen, Mode=TwoWay}"
                    Message="{x:Bind Vm.InfoMessage, Mode=OneWay}"
                    Severity="{x:Bind Vm.InfoSeverity, Mode=OneWay}"
                    Margin="0,-2,0,-2" />
            </Grid>
        </Border>

        <!-- Startup overlay -->
        <Grid
            x:Name="LoadingOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#E614161c"
            Visibility="Visible"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Image Source="/Assets/icon256.png" Width="72" Height="72" HorizontalAlignment="Center" />
                <TextBlock
                    Text="DeskVerse"
                    Style="{StaticResource SectionTitleText}"
                    HorizontalAlignment="Center" />
                <ProgressRing IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="LoadingText"
                    Text="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                    Style="{StaticResource SubtitleText}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
