<Page
    x:Class="Deskverse.App.Views.StudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24,32,24" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Left">
            <StackPanel Style="{StaticResource PageHeaderPanel}">
                <TextBlock Text="Studio" Style="{StaticResource DisplayTitleText}" />
                <TextBlock
                    Text="Curate metadata and visual features. Better metadata means better recommendations."
                    Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <Border
                Style="{StaticResource PanelStyle}"
                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Spacing="10" HorizontalAlignment="Center" Padding="0,30">
                    <FontIcon Glyph="&#xE90B;" FontSize="40" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AnalysisSummary}" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Open one from My Wallpapers or the Home recommendations." Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Preview and apply -->
                <StackPanel Grid.Column="0" Spacing="14">
                    <Border Style="{StaticResource PanelStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Border Style="{StaticResource CardStyle}" Height="220">
                                <Grid>
                                    <FontIcon Glyph="{Binding Wallpaper.KindGlyph}" FontSize="44" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Wallpaper.ThumbnailPath, Converter={StaticResource ThumbnailConverter}}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Grid.Column="0"
                                    Header="Target display"
                                    ItemsSource="{Binding DisplayLabels}"
                                    SelectedItem="{Binding SelectedDisplayLabel, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" />
                                <Button
                                    Grid.Column="1"
                                    Content="Refresh preview"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshThumbnailCommand}"
                                    VerticalAlignment="Bottom" />
                            </Grid>
                            <Button
                                Content="Apply to desktop"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ApplyCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Analysis -->
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Visual analysis" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding AnalysisSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Brightness" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding BrightnessText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentAmberBrush}" />
                                </StackPanel>
                                <ProgressBar Value="{Binding BrightnessPercent}" Maximum="100" Height="6" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Visual density" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding DensityText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentVioletBrush}" />
                                </StackPanel>
                                <ProgressBar Value="{Binding DensityPercent}" Maximum="100" Height="6" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Visibility="{Binding HasDominantColor, Converter={StaticResource BoolToVisibility}}">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding DominantColorHex, Converter={StaticResource HexBrush}}" BorderBrush="{StaticResource GraphiteBorderBrush}" BorderThickness="1" />
                                    <TextBlock Text="{Binding DominantColorHex}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Content="Re-analyze visuals"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ReanalyzeCommand}"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Metadata editor -->
                <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Metadata" Style="{StaticResource SectionTitleText}" />
                        <TextBox Header="Title" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="140" />
                        <TextBox
                            Header="Description"
                            Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MaxHeight="120"
                            MaxLength="500" />
                        <TextBox
                            Header="Categories (comma separated)"
                            PlaceholderText="nature, minimal, dark"
                            Text="{Binding CategoriesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            MaxLength="240" />
                        <TextBlock
                            Text="Categories up to 12, each 30 characters. Analysis and metadata stay on this PC."
                            Style="{StaticResource CaptionText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save metadata" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
                            <ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
