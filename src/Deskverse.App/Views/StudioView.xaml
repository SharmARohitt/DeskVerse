<Page
    x:Class="Deskverse.App.Views.StudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Deskverse.App.Views"
    xmlns:vm="using:Deskverse.App.ViewModels">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">

            <StackPanel Style="{StaticResource PageHeaderPanel}">
                <TextBlock Text="Studio" Style="{StaticResource DisplayTitleText}" />
                <TextBlock Text="Curate metadata, run visual analysis, and apply to any display." Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <!-- No wallpaper selected -->
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="12"
                Padding="0,60,0,0"
                Visibility="{x:Bind conv:Converters.NegateVisibility(ViewModel.Wallpaper), Mode=OneWay}">
                <FontIcon Glyph="&#xE90B;" FontSize="52" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.AnalysisSummary, Mode=OneWay}"
                    Style="{StaticResource SubtitleText}"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="400" />
            </StackPanel>

            <!-- Wallpaper detail panel -->
            <Border
                Style="{StaticResource PanelStyle}"
                Visibility="{x:Bind conv:Converters.ToVisibility(ViewModel.Wallpaper), Mode=OneWay}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail -->
                    <StackPanel Grid.Column="0" Spacing="10">
                        <Border Style="{StaticResource CardStyle}" Height="180">
                            <Grid>
                                <FontIcon
                                    Glyph="{x:Bind ViewModel.Wallpaper.KindGlyph, Mode=OneWay}"
                                    FontSize="40"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Image
                                    Source="{x:Bind conv:Converters.ToImage(ViewModel.Wallpaper.ThumbnailPath), Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.Wallpaper.DimensionsText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{x:Bind ViewModel.Wallpaper.SizeText, Mode=OneWay}" Style="{StaticResource CaptionText}" />

                        <!-- Display selector -->
                        <ComboBox
                            Header="Apply to display"
                            ItemsSource="{x:Bind ViewModel.DisplayLabels}"
                            SelectedItem="{x:Bind ViewModel.SelectedDisplayLabel, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Select target display" />

                        <Button
                            Content="Apply"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ApplyCommand}"
                            AutomationProperties.Name="Apply wallpaper to selected display" />
                    </StackPanel>

                    <!-- Metadata editor -->
                    <StackPanel Grid.Column="1" Spacing="14">
                        <TextBox
                            Header="Title"
                            Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Wallpaper title" />
                        <TextBox
                            Header="Description"
                            Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            Height="80"
                            TextWrapping="Wrap"
                            AutomationProperties.Name="Wallpaper description" />
                        <TextBox
                            Header="Categories (comma-separated)"
                            Text="{x:Bind ViewModel.CategoriesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Wallpaper categories" />

                        <!-- Visual analysis summary -->
                        <Border Style="{StaticResource CardStyle}" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Visual Analysis" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.AnalysisSummary, Mode=OneWay}"
                                    Style="{StaticResource CaptionText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Content="Save metadata"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{x:Bind ViewModel.SaveCommand}"
                                AutomationProperties.Name="Save wallpaper metadata" />
                            <Button
                                Content="Re-analyse"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.ReanalyzeCommand}"
                                AutomationProperties.Name="Re-run visual analysis" />
                            <ProgressRing
                                Width="18" Height="18"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind conv:Converters.ToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
