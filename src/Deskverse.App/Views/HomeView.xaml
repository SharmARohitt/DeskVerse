<Page
    x:Class="Deskverse.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Deskverse.App.Views"
    xmlns:vm="using:Deskverse.App.ViewModels">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Left">

            <StackPanel Style="{StaticResource PageHeaderPanel}">
                <TextBlock Text="{x:Bind ViewModel.GreetingText, Mode=OneWay}" Style="{StaticResource DisplayTitleText}" />
                <TextBlock Text="{x:Bind ViewModel.LibrarySummaryText, Mode=OneWay}" Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <!-- Engine status -->
            <Border Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource AccentAmberBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EngineStateText, Mode=OneWay}" Style="{StaticResource SectionTitleText}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.EngineDetailText, Mode=OneWay}" Style="{StaticResource SubtitleText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Content="Pause"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.PauseEngineCommand}" />
                        <Button
                            Content="Resume"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.ResumeEngineCommand}" />
                        <Button
                            Content="Stop"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{x:Bind ViewModel.StopEngineCommand}" />
                        <Button
                            Content="Restore previous"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.RestorePreviousCommand}" />
                        <Button
                            Content="Surprise me"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.SurpriseMeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active wallpaper -->
            <Border
                Style="{StaticResource PanelStyle}"
                Visibility="{x:Bind conv:Converters.ToVisibility(ViewModel.ActiveWallpaper), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Currently on your desktop" Style="{StaticResource SectionTitleText}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Style="{StaticResource CardStyle}" Width="260" Height="146">
                            <Grid>
                                <Image
                                    Source="{x:Bind conv:Converters.ToImage(ViewModel.ActiveWallpaper.ThumbnailPath), Mode=OneWay}"
                                    Stretch="UniformToFill"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Border
                                    Background="{StaticResource GraphitePanelBrush}"
                                    Visibility="{x:Bind conv:Converters.NegateVisibility(ViewModel.ActiveWallpaper.HasThumbnail), Mode=OneWay}"
                                    Padding="0">
                                    <FontIcon
                                        Glyph="{x:Bind ViewModel.ActiveWallpaper.KindGlyph}"
                                        FontSize="40"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveWallpaper.Title, Mode=OneWay}" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveWallpaper.DimensionsText, Mode=OneWay}" Style="{StaticResource SubtitleText}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveWallpaper.CategoriesText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveWallpaper.UseCountText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recommendations -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Recommended for you" Style="{StaticResource SectionTitleText}" />
                    <Border
                        Style="{StaticResource InfoPillStyle}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind conv:Converters.ToVisibility(ViewModel.HasRecommendations), Mode=OneWay}">
                        <TextBlock Text="explainable scoring" Style="{StaticResource CaptionText}" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Text="No recommendations yet. Import or download wallpapers, use them, and tell DeskVerse what you like."
                    Style="{StaticResource SubtitleText}"
                    Visibility="{x:Bind conv:Converters.NegateVisibility(ViewModel.HasRecommendations), Mode=OneWay}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recommendations}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="340" MinItemHeight="150" MinRowSpacing="12" MinColumnSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecommendationItemViewModel">
                            <Border Style="{StaticResource PanelStyle}" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Width="150" Height="92" VerticalAlignment="Top">
                                        <Image
                                            Source="{x:Bind conv:Converters.ToImage(Wallpaper.ThumbnailPath), Mode=OneWay}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Wallpaper.Title}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" MaxLines="1" />
                                            <Border Style="{StaticResource InfoPillStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ScoreText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentAmberBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Explanation}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxLines="2" />
                                        <ItemsControl ItemsSource="{x:Bind Factors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RecommendationFactorViewModel">
                                                    <Border Style="{StaticResource InfoPillStyle}" ToolTipService.ToolTip="{x:Bind Detail}">
                                                        <TextBlock Style="{StaticResource CaptionText}">
                                                            <Run Text="{x:Bind Name}" Foreground="{StaticResource AccentTealBrush}" />
                                                            <Run Text=" weight" Foreground="{StaticResource TextMutedBrush}" />
                                                            <Run Text="{x:Bind WeightText}" />
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Content="Apply"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="12,5"
                                                Command="{x:Bind Wallpaper.ApplyCommand}" />
                                            <Button
                                                Content="Open in Studio"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,5"
                                                Command="{x:Bind Wallpaper.SelectCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Import shortcut -->
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8B5;" FontSize="18" Foreground="{StaticResource AccentVioletBrush}" />
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Bring your own wallpapers" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="Import local images and videos — originals are never modified or deleted." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <Button
                        Content="Import files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.ImportWallpapersCommand}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
