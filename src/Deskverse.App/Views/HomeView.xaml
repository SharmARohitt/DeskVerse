<Page
    x:Class="Deskverse.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deskverse.App.ViewModels">

    <ScrollViewer Padding="32,24,32,24" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Left">

            <StackPanel Style="{StaticResource PageHeaderPanel}">
                <TextBlock Text="{Binding GreetingText}" Style="{StaticResource DisplayTitleText}" />
                <TextBlock Text="{Binding LibrarySummaryText}" Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <Border Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource AccentAmberBrush}" />
                            <TextBlock Text="{Binding EngineStateText}" Style="{StaticResource SectionTitleText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EngineDetailText}" Style="{StaticResource SubtitleText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Pause" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PauseEngineCommand}" />
                        <Button Content="Resume" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResumeEngineCommand}" />
                        <Button Content="Stop" Style="{StaticResource DangerButtonStyle}" Command="{Binding StopEngineCommand}" />
                        <Button Content="Restore previous" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestorePreviousCommand}" />
                        <Button Content="Surprise me" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SurpriseMeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelStyle}" Visibility="{Binding ActiveWallpaper, Converter={StaticResource NotNullToVisibility}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Currently on your desktop" Style="{StaticResource SectionTitleText}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Style="{StaticResource CardStyle}" Width="260" Height="146">
                            <Grid>
                                <FontIcon Glyph="{Binding ActiveWallpaper.KindGlyph}" FontSize="40" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ActiveWallpaper.ThumbnailPath, Converter={StaticResource ThumbnailConverter}}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveWallpaper.Title}" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding ActiveWallpaper.DimensionsText}" Style="{StaticResource SubtitleText}" />
                            <TextBlock Text="{Binding ActiveWallpaper.CategoriesText}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding ActiveWallpaper.UseCountText}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Recommended for you" Style="{StaticResource SectionTitleText}" />
                    <Border Style="{StaticResource InfoPillStyle}" VerticalAlignment="Center" Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="explainable scoring" Style="{StaticResource CaptionText}" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Text="No recommendations yet. Import or download wallpapers, use them, and tell DeskVerse what you like."
                    Style="{StaticResource SubtitleText}"
                    Visibility="{Binding HasRecommendations, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsRepeater ItemsSource="{Binding Recommendations}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="380" MinItemHeight="252" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecommendationItemViewModel">
                            <Border Style="{StaticResource PanelStyle}" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Width="150" Height="92" VerticalAlignment="Top">
                                        <Grid>
                                            <FontIcon Glyph="{x:Bind Wallpaper.KindGlyph}" FontSize="20" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind Wallpaper.ThumbnailPath, Converter={StaticResource ThumbnailConverter}, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Wallpaper.Title}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource InfoPillStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ScoreText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentAmberBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Explanation}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxLines="3" />
                                        <ItemsControl ItemsSource="{x:Bind Factors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="150" ItemHeight="34" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RecommendationFactorViewModel">
                                                    <Border Style="{StaticResource InfoPillStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind Detail}">
                                                        <TextBlock Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentTealBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" Command="{x:Bind Wallpaper.ApplyCommand}" />
                                            <Button Content="Open in Studio" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Command="{x:Bind Wallpaper.SelectCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8B5;" FontSize="18" Foreground="{StaticResource AccentVioletBrush}" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Bring your own wallpapers" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="Import local images and videos — originals are never modified or deleted." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <Button Content="Import files" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImportWallpapersCommand}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
