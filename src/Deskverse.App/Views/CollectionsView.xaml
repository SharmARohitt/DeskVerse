<Page
    x:Class="Deskverse.App.Views.CollectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Deskverse.App.Views"
    xmlns:vm="using:Deskverse.App.ViewModels">

    <Grid x:Name="Root" Padding="32,24,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left rail: collection list -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
                <TextBlock Text="Collections" Style="{StaticResource DisplayTitleText}" />
                <TextBlock Text="Group wallpapers into playlists and queues." Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
                <TextBox
                    PlaceholderText="New collection name"
                    Text="{x:Bind ViewModel.NewCollectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    MaxLength="60" />
                <Button
                    Content="Create collection"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{x:Bind ViewModel.CreateCommand}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Collections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CollectionTileViewModel">
                            <Border
                                Style="{StaticResource CardStyle}"
                                Padding="12,10"
                                Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource AccentVioletBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind CountText}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button
                                            Content="Open"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,4"
                                            Command="{x:Bind SelectCommand}" />
                                        <Button
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="7,4"
                                            Visibility="{x:Bind conv:Converters.NegateVisibility(IsSystem), Mode=OneWay}"
                                            Command="{x:Bind DeleteCommand}"
                                            ToolTipService.ToolTip="Delete this collection">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Right detail: selected collection contents -->
        <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBox
                        Header="Collection name"
                        Text="{x:Bind ViewModel.SelectedDetailTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="60" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Rename"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.RenameCommand}" />
                        <Button
                            Content="Refresh"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.LoadCommand}" />
                        <Button
                            x:Name="AddStudioSelectionButton"
                            Content="Add Studio selection"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnAddStudioSelectionClick"
                            ToolTipService.ToolTip="Adds the wallpaper currently open in Studio to this collection" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SelectedDetailSubtitle, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Spacing="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind conv:Converters.ToVisibility(ViewModel.HasNoSelectedItems), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="Pick wallpapers in My Wallpapers or Studio and add them here." Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="0,16,0,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedItems}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="230" MinItemHeight="220" MinRowSpacing="12" MinColumnSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:WallpaperItemViewModel">
                                <Border Style="{StaticResource CardStyle}" Padding="8">
                                    <StackPanel Spacing="6">
                                        <Border Style="{StaticResource CardStyle}" Height="120">
                                            <Grid>
                                                <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="28" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{x:Bind conv:Converters.ToImage(ThumbnailPath), Mode=OneWay}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DimensionsText}" Style="{StaticResource CaptionText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" Command="{x:Bind ApplyCommand}" />
                                            <Button Content="Studio" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Command="{x:Bind SelectCommand}" />
                                            <Button
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="7,4"
                                                Command="{Binding DataContext.RemoveItemCommand, ElementName=Root}"
                                                CommandParameter="{x:Bind}"
                                                ToolTipService.ToolTip="Remove from this collection (keeps the wallpaper in your library)">
                                                <FontIcon Glyph="&#xE738;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
