<Page
    x:Class="Deskverse.App.Views.StorageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Deskverse.App.Views"
    xmlns:vm="using:Deskverse.App.ViewModels">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Style="{StaticResource PageHeaderPanel}">
                <TextBlock Text="Storage" Style="{StaticResource DisplayTitleText}" />
                <TextBlock Text="Manage your managed wallpaper cache and free up disk space." Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <!-- Health status -->
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Title="{x:Bind ViewModel.HealthText, Mode=OneWay}"
                Message="{x:Bind ViewModel.HealthMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.HealthSeverity, Mode=OneWay}" />

            <!-- Threshold warning (non-spammy inline banner) -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasThresholdWarning, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="Storage threshold"
                Message="{x:Bind ViewModel.ThresholdWarning, Mode=OneWay}"
                Visibility="{x:Bind conv:Converters.ToVisibility(ViewModel.HasThresholdWarning), Mode=OneWay}" />

            <!-- Usage meter -->
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cache Usage" Style="{StaticResource SectionTitleText}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CaptionText}"
                            VerticalAlignment="Center">
                            <Run Text="{x:Bind ViewModel.UsedText, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{x:Bind ViewModel.LimitText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <ProgressBar
                        Value="{x:Bind ViewModel.UsedPercent, Mode=OneWay}"
                        Maximum="100"
                        Height="8"
                        CornerRadius="4"
                        AutomationProperties.Name="Cache usage percentage" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.CachedCountText, Mode=OneWay}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" />
                                <TextBlock Text="cached entries" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ActiveText, Mode=OneWay}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" />
                                <TextBlock Text="active wallpaper" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.PinnedText, Mode=OneWay}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" />
                                <TextBlock Text="pinned (protected)" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource MetricTileStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.DiskText, Mode=OneWay}" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" />
                                <TextBlock Text="free on drive" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cache location -->
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Cache Location" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{x:Bind ViewModel.CacheDirectory, Mode=OneWay}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                    <Button
                        Content="Move cache to another folder…"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnMoveCacheClick"
                        AutomationProperties.Name="Move cache to another folder" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Maintenance" Style="{StaticResource SectionTitleText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Content="Clean up cache"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.CleanupCommand}"
                            AutomationProperties.Name="Clean up cache using LRU policy" />
                        <Button
                            Content="Reconcile"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.ReconcileCommand}"
                            ToolTipService.ToolTip="Repair any divergence between the cache folder and the database"
                            AutomationProperties.Name="Reconcile cache with database" />
                        <ProgressRing
                            Width="18" Height="18"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind conv:Converters.ToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Text="Clean up removes least-recently-used wallpapers to free space. Pinned and active wallpapers are never touched."
                        Style="{StaticResource CaptionText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
