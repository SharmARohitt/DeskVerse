<Page
    x:Class="Deskverse.App.Views.StorageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24,32,24" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" MaxWidth="1080" HorizontalAlignment="Left">
            <StackPanel Style="{StaticResource PageHeaderPanel}">
                <TextBlock Text="Storage" Style="{StaticResource DisplayTitleText}" />
                <TextBlock Text="The managed cache is yours to control. Cleanup never touches the active or pinned wallpapers." Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Title="{Binding HealthText}"
                Message="{Binding HealthMessage}"
                Severity="{Binding HealthSeverity}" />

            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Cache usage" Style="{StaticResource SectionTitleText}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UsedText}" Style="{StaticResource SubtitleText}" Foreground="{StaticResource AccentAmberBrush}" />
                            <TextBlock Text="of" Style="{StaticResource SubtitleText}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding LimitText}" Style="{StaticResource SubtitleText}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource InfoPillStyle}">
                            <TextBlock Text="{Binding CachedCountText}" Style="{StaticResource CaptionText}" />
                        </Border>
                    </Grid>
                    <ProgressBar
                        Value="{Binding UsedPercent}"
                        Maximum="100"
                        Height="10"
                        Foreground="{StaticResource AccentAmberBrush}"
                        Background="{StaticResource GraphiteElevatedBrush}" />

                    <TextBlock
                        Text="Move the cache"
                        Style="{StaticResource SubtitleText}"
                        Margin="0,10,0,0" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding CacheDirectory}"
                            Style="{StaticResource CaptionText}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            x:Name="ChangeDirectoryButton"
                            Content="Change…"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnChangeDirectoryClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricTileStyle}" Margin="0,0,10,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Active wallpaper" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding ActiveText}" Style="{StaticResource MetricValueText}" />
                        <TextBlock Text="protected from cleanup" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}" Margin="0,0,10,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pinned" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding PinnedText}" Style="{StaticResource MetricValueText}" />
                        <TextBlock Text="protected from cleanup" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}" Margin="0,0,10,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Thumbnails" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding ThumbnailText}" Style="{StaticResource MetricValueText}" />
                        <TextBlock Text="regenerated on demand" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricTileStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Free on disk" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource MetricValueText}" />
                        <TextBlock Text="on the cache volume" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Maintenance" Style="{StaticResource SectionTitleText}" />
                    <TextBlock
                        Text="Run LRU cleanup now or reconcile the cache with the database after an unexpected shutdown."
                        Style="{StaticResource CaptionText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Run cleanup now" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CleanupCommand}" />
                        <Button Content="Reconcile cache" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ReconcileCommand}" />
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}" />
                        <ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
